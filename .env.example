# LLM Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_key_here  # Optional fallback
GEMINI_MODEL=gemini-3.1-flash-lite

# Agent Configuration
MAX_TOOL_CALLS=5
MAX_TOKENS_PER_INTERACTION=4000
MAX_LATENCY_MS=8000
CONFIDENCE_THRESHOLD=0.6

# RAG Configuration
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large
FAISS_INDEX_PATH=data/faiss_index
TOP_K_RETRIEVAL=15
TOP_K_RERANK=5
RRF_K=60

# Elasticsearch (for BM25)
ES_HOST=http://localhost:9200

# MCP Server
MCP_HOST=0.0.0.0
MCP_PORT=8001

# API
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
TRACE_LOG_DIR=logs/

# REDIS CONFIGURATION (Production State Management)
# For Docker Compose: use the service name
REDIS_URL=redis://redis:6379/0
# For local development (without Docker):
# REDIS_URL=redis://localhost:6379/0
# Individual connection params (fallback if REDIS_URL not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password_here
# Conversation TTL (default: 72 hours = 259200 seconds)
CONVERSATION_TTL_SECONDS=259200
# Response cache TTL (default: 5 minutes = 300 seconds)
RESPONSE_CACHE_TTL_SECONDS=300
# RAGAS evaluation
ENABLE_RAGAS_EVAL=true

# Langsmith for observability
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-financial-assistant

OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=rbi_reports

# RAG Feature Flags (NEW)
USE_RERANKER=true
USE_HYDE=true
USE_CRAG=true
USE_ROUTER=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3