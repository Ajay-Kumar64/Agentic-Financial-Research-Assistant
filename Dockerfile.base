FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# CPU-only PyTorch (saves ~2GB vs CUDA)
RUN pip install --no-cache-dir --default-timeout=300 torch --index-url https://download.pytorch.org/whl/cpu

# All other dependencies
COPY requirements-docker.txt .
RUN pip install --no-cache-dir --default-timeout=300 -r requirements-docker.txt